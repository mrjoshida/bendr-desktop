{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "event:default",
    "window:default",
    "window:allow-create",
    "window:allow-set-fullscreen"
  ]
}
